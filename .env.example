# ── Slack ───────────────────────────────────────────────────────────────
# Bot token (OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-...
# App-level token with the connections:write scope (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-...
# Who may talk to the bot (Slack profile → ⋮ → Copy member ID). Comma-separated.
ALLOWED_SLACK_USER_IDS=U0123456789

# ── GitHub ──────────────────────────────────────────────────────────────
# Repos the bot may work on, comma-separated. "your-org/*" means every repo the token can see in that org.
GITHUB_REPOS=your-org/api,your-org/web
# Fine-grained token for those repos: Contents (read/write), Pull requests (read/write), Metadata (read)
GH_TOKEN=github_pat_...
GIT_AUTHOR_NAME=parcerito
GIT_AUTHOR_EMAIL=parcerito@users.noreply.github.com

# ── Claude (the brain) ──────────────────────────────────────────────────
# From `claude setup-token` (uses your Pro/Max subscription). Don't also set ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ── Codex (the hands) ───────────────────────────────────────────────────
# Login is stored in $CODEX_HOME/auth.json (see README). Optional bootstrap:
# CODEX_AUTH_JSON_B64=
CODEX_MODEL=gpt-6.1-sol
CODEX_EFFORT=medium
CODEX_SANDBOX=danger-full-access

# ── Optional integrations ───────────────────────────────────────────────
# Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY=
# Sentry → Settings → User Auth Tokens (scopes: see https://github.com/getsentry/sentry-mcp)
SENTRY_ACCESS_TOKEN=
# SENTRY_HOST=sentry.example.com

# ── Daily meeting agenda (optional) ─────────────────────────────────────
# Every weekday at AGENDA_TIME it reads these channels, makes sure every message from outside the team is
# tracked in Linear (filing missing ones in Triage on Dotterino's behalf), and DMs you an HTML agenda.
# Needs LINEAR_API_KEY. Invite the bot to each channel. DM it `agenda` to build one on demand.
AGENDA_CHANNELS=
# Slack member IDs of the internal team; everyone else counts as the service team.
AGENDA_INTERNAL_USER_IDS=
# AGENDA_RECIPIENT_ID=        # defaults to the first ALLOWED_SLACK_USER_IDS entry
AGENDA_TIME=10:00
AGENDA_TIMEZONE=America/Bogota
# Start of the first window only, e.g. 2026-10-14T00:00:00-05:00
# AGENDA_BACKFILL_SINCE=
LINEAR_TEAM_KEY=ENG

# ── Local dev only (the Docker image sets these to /data/...) ───────────
# DATA_DIR=./data
BOT_NAME=Parcerito

# Optional shared Lime coder-feedback workspace (ENG-3568).
# LIME_REVIEW_API_URL=https://your-backend-host
# LIME_REVIEW_INGEST_KEY=  # same secret as backend PARCERITO_REVIEW_INGEST_KEY; at least 32 characters
# LIME_REVIEW_WEB_URL=https://app.getlimeai.com/coder-feedback
# LIME_REVIEW_TOPICS_FILE=/data/review/megan-topics.json
# AGENCY_DOCS_DIR=/data/agency-docs
