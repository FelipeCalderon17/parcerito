# ── Slack ───────────────────────────────────────────────────────────────
# Bot token (OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-...
# App-level token with the connections:write scope (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-...
# Who may talk to the bot (Slack profile → ⋮ → Copy member ID). Comma-separated.
ALLOWED_SLACK_USER_IDS=U0123456789

# ── GitHub ──────────────────────────────────────────────────────────────
# Repos the bot may work on, comma-separated. "your-org/*" means every repo the token can see in that org.
GITHUB_REPOS=your-org/api,your-org/web
# Fine-grained token for those repos: Contents (read/write), Pull requests (read/write), Metadata (read)
GH_TOKEN=github_pat_...
GIT_AUTHOR_NAME=parcerito
GIT_AUTHOR_EMAIL=parcerito@users.noreply.github.com

# ── Claude (the brain) ──────────────────────────────────────────────────
# From `claude setup-token` (uses your Pro/Max subscription). Don't also set ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ── Codex (the hands) ───────────────────────────────────────────────────
# Login is stored in $CODEX_HOME/auth.json (see README). Optional bootstrap:
# CODEX_AUTH_JSON_B64=
CODEX_MODEL=gpt-6.1-sol
CODEX_EFFORT=medium
CODEX_SANDBOX=danger-full-access

# ── Optional integrations ───────────────────────────────────────────────
# Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY=
# Sentry → Settings → User Auth Tokens (scopes: see https://github.com/getsentry/sentry-mcp)
SENTRY_ACCESS_TOKEN=
# SENTRY_HOST=sentry.example.com

# ── Local dev only (the Docker image sets these to /data/...) ───────────
# DATA_DIR=./data
BOT_NAME=Parcerito
