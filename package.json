{
  "name": "parcerito",
  "version": "0.1.0",
  "description": "Your coding parcero in Slack: Claude plans and reviews, Codex writes the code, and you get a PR.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "icon": "node scripts/render-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex-sdk": "^0.161.0",
    "@slack/bolt": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
